{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/contract_ir_v0_1.schema.json",
  "title": "ContractIR v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "sources",
    "indices",
    "tables",
    "derived",
    "open_items"
  ],
  "properties": {
    "schema_version": { "const": "contract_ir_v0_1" },
    "contract_id": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    },
    "indices": {
      "type": "array",
      "items": { "$ref": "#/$defs/index" }
    },
    "tables": {
      "type": "array",
      "items": { "$ref": "#/$defs/table" }
    },
    "derived": {
      "type": "array",
      "items": { "$ref": "#/$defs/derived_fn" }
    },
    "cashflows": {
      "type": "array",
      "items": { "$ref": "#/$defs/cashflow" }
    },
    "open_items": {
      "type": "array",
      "items": { "$ref": "#/$defs/open_item" }
    }
  },
  "$defs": {
    "anchor_id": {
      "type": "string",
      "pattern": "^A\\d{4,}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "kind", "item_id", "anchor_ids"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "item_id": { "type": "string", "minLength": 1 },
        "anchor_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/anchor_id" }
        },
        "notes": { "type": ["string", "null"] }
      }
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": ["series_id", "unit"],
      "properties": {
        "series_id": { "type": "string", "minLength": 1 },
        "unit": { "enum": ["rate", "bps", "decimal", "money", "bool", "string"] },
        "description": { "type": ["string", "null"] }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["string", "decimal", "rate", "bps", "money", "bool", "date"] }
      }
    },
    "table_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cells", "source_refs"],
      "properties": {
        "row_id": { "type": ["string", "null"] },
        "cells": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/literal_node" }
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/anchor_id" }
        }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table_id", "columns", "rows"],
      "properties": {
        "table_id": { "type": "string", "minLength": 1 },
        "description": { "type": ["string", "null"] },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/column" }
        },
        "rows": {
          "type": "array",
          "items": { "$ref": "#/$defs/table_row" }
        }
      }
    },
    "arg": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["string", "decimal", "rate", "bps", "money", "bool", "date"] }
      }
    },
    "derived_fn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fn_id", "semantic_role", "args", "returns", "expr", "source_refs"],
      "properties": {
        "fn_id": { "type": "string", "minLength": 1 },
        "semantic_role": {
          "enum": ["base_rate", "margin", "all_in_rate", "other"]
        },
        "description": { "type": ["string", "null"] },
        "args": {
          "type": "array",
          "items": { "$ref": "#/$defs/arg" }
        },
        "returns": { "enum": ["string", "decimal", "rate", "bps", "money", "bool", "date"] },
        "expr": { "$ref": "#/$defs/ast_node" },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/anchor_id" }
        }
      }
    },
    "open_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issue", "source_refs", "blocking"],
      "properties": {
        "issue": { "type": "string", "minLength": 1 },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/anchor_id" }
        },
        "suggested_parameters": {
          "type": "array",
          "items": { "type": "string" }
        },
        "blocking": { "type": "boolean" }
      }
    },
    "cashflow": {
      "type": "object",
      "additionalProperties": true
    },
    "literal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "enum": ["decimal", "integer", "rate", "bps", "money", "string", "bool", "date"] },
        "value": {}
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["decimal", "rate", "bps", "money"] } } },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^-?\\d+(\\.\\d+)?$"
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "integer" } } },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^-?\\d+$"
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "string" } } },
          "then": { "properties": { "value": { "type": "string" } } }
        },
        {
          "if": { "properties": { "type": { "const": "bool" } } },
          "then": { "properties": { "value": { "type": "boolean" } } }
        },
        {
          "if": { "properties": { "type": { "const": "date" } } },
          "then": { "properties": { "value": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" } } }
        }
      ]
    },
    "literal_node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lit"],
      "properties": {
        "lit": { "$ref": "#/$defs/literal" }
      }
    },
    "var_node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["var"],
      "properties": {
        "var": { "type": "string", "minLength": 1 }
      }
    },
    "op_node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "args"],
      "properties": {
        "op": {
          "enum": [
            "index",
            "add",
            "sub",
            "mul",
            "div",
            "max",
            "min",
            "round_up_to_increment",
            "bps_to_rate",
            "lookup",
            "lookup2",
            "if",
            "eq",
            "lt",
            "lte",
            "gt",
            "gte",
            "and",
            "or",
            "not"
          ]
        },
        "args": {
          "type": "array",
          "items": { "$ref": "#/$defs/ast_node" }
        }
      }
    },
    "ast_node": {
      "oneOf": [
        { "$ref": "#/$defs/literal_node" },
        { "$ref": "#/$defs/var_node" },
        { "$ref": "#/$defs/op_node" }
      ]
    }
  }
}
